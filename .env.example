# ─── Base de données ────────────────────────────────────────────────────────
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_secret
POSTGRES_DB=radar_pme
POSTGRES_PORT=5432

DATABASE_URL=postgresql://radar:radar_secret@localhost:5432/radar_pme

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Mode démonstration ──────────────────────────────────────────────────────
# true  = données fictives intégrées (aucune API externe requise)
# false = connecteurs API officiels actifs
DEMO_DATA=true

# ─── Sources de données officielles (optionnel si DEMO_DATA=false) ───────────
# INSEE / SIRENE
SIRENE_API_KEY=

# INPI / RNE
INPI_API_URL=https://registre-national-entreprises.inpi.fr/api
INPI_API_KEY=

# BODACC (API publique — aucune clé requise pour l'instant)
BODACC_API_URL=https://bodacc-datadila.opendatasoft.com/api/explore/v2.1

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
